{
  "name": "dsh-memos-panel",
  "version": "1.2.0",
  "type": "module",
  "description": "Third-party Chinese settings panel for the official MemOS Cloud DSH plugin",
  "license": "MIT AND Apache-2.0",
  "author": "lxl2000927",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxl2000927/dsh-memos-panel.git"
  },
  "homepage": "https://github.com/lxl2000927/dsh-memos-panel#readme",
  "bugs": {"url": "https://github.com/lxl2000927/dsh-memos-panel/issues"},
  "keywords": ["dsh-plugin", "deepseek-harness", "memos", "memory", "settings", "chinese"],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./guarded-memos": "./lib/guarded-memos.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "client", "locale", "vendor", "icon.svg", "cordis.patch.yml", "README.md"],
  "peerDependencies": {"@memtensor/memos-cloud-dsh-plugin": "0.1.2"},
  "peerDependenciesMeta": {"@memtensor/memos-cloud-dsh-plugin": {"optional": true}},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "engines": {"node": ">=24.9", "dsh": ">=0.2.1-rc.2 <0.3.0-0"},
  "scripts": {"test": "node --test tests/*.test.mjs"}
}
